# Copy to `.env` and adjust the values before running `docker compose up`.

# Postgres credentials, used by the "db" service and to build the backend's
# DATABASE_URL (see backend/src/db/pool.js).
POSTGRES_USER=invite_to_party
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invite_to_party

# Secret used to sign/verify the JWT auth cookie (backend/src/routes/auth.js,
# backend/src/middleware/auth.js). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Host ports docker-compose exposes the containers on.
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=80

# Default UI language baked into the frontend at build time ("en" or "de").
# Guests/hosts can still switch languages in the app (except on the
# login/guest/index pages, where the language switch isn't shown); this only
# sets what they see before making a choice. Leave unset to default to "en".
# DEFAULT_LOCALE=de

# Isolated Postgres instance for local backend test runs (never the same
# database as POSTGRES_DB above - backend/tests/helpers/db.js truncates
# tables between tests and refuses to run unless the database name contains
# "test"). Start it with: docker compose --profile test up -d db-test
TEST_POSTGRES_USER=invite_to_party_test
TEST_POSTGRES_PASSWORD=invite_to_party_test
TEST_POSTGRES_DB=invite_to_party_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgres://invite_to_party_test:invite_to_party_test@localhost:5433/invite_to_party_test

# Optional: paths (relative to the repo root) to a custom logo/favicon,
# bind-mounted over the generic defaults at container start (see
# docker-compose.yml). Leave unset to use the generic defaults shipped in
# frontend/public/logo.default.svg and favicon.default.svg.
# LOGO_FILE=./path/to/your-logo.svg
# FAVICON_FILE=./path/to/your-favicon.svg
